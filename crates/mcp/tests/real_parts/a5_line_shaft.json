{
  "name": "Line shaft on two bearing units",
  "kind": "assembly",
  "parameters": {"bw": 20, "bh": 40, "bd": 40, "r": 10, "L": 200, "span": 150, "ring": 16},
  "steps": [
    {"id": 1, "name": "Block outline", "type": "sketch", "regions": [{"outer": {"type": "rect", "x": "-bd / 2", "y": "-bw / 2", "w": "bd", "h": "bw"}}]},
    {"id": 2, "name": "Block", "type": "extrude", "sketch": 1, "length": "bh", "mode": "new_body"},
    {"id": 3, "name": "Seat", "type": "sketch", "plane": {"origin": [0, "bw / 2 + 1", 0], "z": [0, -1, 0], "x": [1, 0, 0]}, "regions": [{"outer": {"type": "circle", "cx": 0, "cy": "bh / 2", "r": "ring"}}]},
    {"id": 4, "name": "Bore it", "type": "extrude", "sketch": 3, "length": "bw + 2", "mode": "remove"},
    {"id": 5, "name": "Bearing ring", "type": "sketch", "plane": {"origin": [200, 0, 0]}, "regions": [{"outer": {"type": "circle", "r": "ring"}, "holes": [{"type": "circle", "r": "r"}]}]},
    {"id": 6, "name": "Ring solid", "type": "extrude", "sketch": 5, "length": "bw", "mode": "new_body"},
    {"id": 7, "name": "Shaft", "type": "sketch", "plane": {"origin": [300, 0, 0]}, "regions": [{"outer": {"type": "circle", "r": "r"}}]},
    {"id": 8, "name": "Shaft solid", "type": "extrude", "sketch": 7, "length": "L", "mode": "new_body"},
    {"expect": {"parts": 3}},
    {"tool": "tab_new", "args": {"type": "assembly", "name": "Bearing unit"}},
    {"tool": "instance_add", "args": {"part": "f2", "fixed": true, "name": "Block"}, "as": "block"},
    {"tool": "instance_add", "args": {"part": "f6", "name": "Ring"}, "as": "ring"},
    {"tool": "mate_add", "label": "The ring in its seat", "args": {"type": "fastened",
      "a": {"instance": "$ring", "on": {"face": "f6:hole.0.side.0", "point": "axis_middle"}},
      "b": {"instance": "$block", "on": {"frame": {"origin": [0, 0, 20], "z": [0, 1, 0], "x": [1, 0, 0]}}}}},
    {"expect": {"failing": 0, "freedom": 0, "interferences": 0, "bom": {"Block": 1, "Ring": 1}}},
    {"tool": "tab_new", "args": {"type": "assembly", "name": "Line shaft"}},
    {"tool": "instance_add", "args": {"assembly": 2, "fixed": true, "name": "Unit 1"}, "as": "u1"},
    {"tool": "instance_add", "args": {"assembly": 2, "name": "Unit 2", "at": {"origin": [150, 0, 0]}}, "as": "u2"},
    {"tool": "instance_edit", "label": "Lock the second unit", "args": {"id": "$u2", "locked": true}},
    {"tool": "instance_add", "args": {"part": "f8", "name": "Shaft"}, "as": "shaft"},
    {"tool": "mate_add", "label": "Shaft in the first unit", "args": {"type": "revolute",
      "a": {"instance": "$shaft", "on": {"face": "f8:side.0", "point": "axis_start"}},
      "b": {"instance": ["$u1", "$ring"], "on": {"face": "f6:hole.0.side.0", "point": "axis_middle"}}}, "as": "m1"},
    {"expect": {"failing": 0}},
    {"expect": {"bom": {"Block": 2, "Ring": 2, "Shaft": 1}}}
  ],
  "always": {"failing": 0},
  "changes": [{"set": {"L": 240}}]
}
