{
  "name": "Gearbox assembly",
  "kind": "assembly",
  "parameters": {"L": 180, "W": 60, "H": 100, "t": 5, "cx": 30, "bore": 6, "SL": 90},
  "steps": [
    {"id": 1, "name": "Footprint", "type": "sketch", "regions": [{"outer": {"type": "rect", "x": "-L / 2", "y": "-W / 2", "w": "L", "h": "W"}}]},
    {"id": 2, "name": "Block", "type": "extrude", "sketch": 1, "length": "H", "mode": "new_body"},
    {"id": 3, "name": "Hollow", "type": "shell", "open": ["f2:end"], "thickness": "t"},
    {"id": 4, "name": "Bearing bores", "type": "sketch", "plane": {"origin": [0, "W / 2 + 1", 0], "z": [0, -1, 0], "x": [1, 0, 0]},
     "regions": [{"outer": {"type": "circle", "cx": "-cx", "cy": "H / 2", "r": "bore"}}, {"outer": {"type": "circle", "cx": "cx", "cy": "H / 2", "r": "bore"}}]},
    {"id": 5, "name": "Cut them", "type": "extrude", "sketch": 4, "length": "W + 2", "mode": "remove"},
    {"id": 6, "name": "Shaft", "type": "sketch", "plane": {"origin": [200, 0, 0]}, "regions": [{"outer": {"type": "circle", "r": "bore"}}]},
    {"id": 7, "name": "Shaft solid", "type": "extrude", "sketch": 6, "length": "SL", "mode": "new_body"},
    {"id": 8, "name": "Small gear", "type": "sketch", "plane": {"origin": [300, 0, 0]}, "regions": [{"outer": {"type": "circle", "r": 19.5}, "holes": [{"type": "circle", "r": "bore"}]}]},
    {"id": 9, "name": "Small gear solid", "type": "extrude", "sketch": 8, "length": 12, "mode": "new_body"},
    {"id": 10, "name": "Big gear", "type": "sketch", "plane": {"origin": [400, 0, 0]}, "regions": [{"outer": {"type": "circle", "r": 39.5}, "holes": [{"type": "circle", "r": "bore"}]}]},
    {"id": 11, "name": "Big gear solid", "type": "extrude", "sketch": 10, "length": 12, "mode": "new_body"},
    {"expect": {"parts": 4}},
    {"tool": "tab_new", "args": {"type": "assembly", "name": "Gearbox"}},
    {"tool": "instance_add", "args": {"part": "f2", "fixed": true, "name": "Housing"}, "as": "h"},
    {"tool": "instance_add", "args": {"part": "f7", "name": "Input shaft"}, "as": "s1"},
    {"tool": "instance_add", "args": {"part": "f7", "name": "Output shaft"}, "as": "s2"},
    {"tool": "instance_add", "args": {"part": "f9", "name": "Small gear"}, "as": "g1"},
    {"tool": "instance_add", "args": {"part": "f11", "name": "Big gear"}, "as": "g2"},
    {"tool": "mate_add", "label": "Input shaft in its bearing", "args": {"type": "revolute",
      "a": {"instance": "$s1", "on": {"face": "f7:side.0", "point": "axis_middle"}},
      "b": {"instance": "$h", "on": {"frame": {"origin": [-30, 0, 50], "z": [0, 1, 0], "x": [1, 0, 0]}}}}, "as": "m1"},
    {"tool": "mate_add", "label": "Output shaft in its bearing", "args": {"type": "revolute",
      "a": {"instance": "$s2", "on": {"face": "f7:side.0", "point": "axis_middle"}},
      "b": {"instance": "$h", "on": {"frame": {"origin": [30, 0, 50], "z": [0, 1, 0], "x": [1, 0, 0]}}}}, "as": "m2"},
    {"tool": "mate_add", "label": "Small gear on the input shaft", "args": {"type": "fastened",
      "a": {"instance": "$g1", "on": {"face": "f9:hole.0.side.0", "point": "axis_middle"}},
      "b": {"instance": "$s1", "on": {"face": "f7:side.0", "point": "axis_middle"}}}},
    {"tool": "mate_add", "label": "Big gear on the output shaft", "args": {"type": "fastened",
      "a": {"instance": "$g2", "on": {"face": "f11:hole.0.side.0", "point": "axis_middle"}},
      "b": {"instance": "$s2", "on": {"face": "f7:side.0", "point": "axis_middle"}}}},
    {"expect": {"failing": 0, "freedom": 2}},
    {"tool": "relation_add", "label": "The gears mesh", "args": {"type": "gear", "ratio": -0.5, "a": "$m1", "b": "$m2"}},
    {"expect": {"failing": 0, "freedom": 1, "interferences": 0, "bom": {"Housing": 1, "Input shaft": 2, "Small gear": 1, "Big gear": 1}}},
    {"tool": "mate_set_value", "label": "Turn the input one and a half times", "args": {"id": "$m1", "dof": "angle", "value": 540}},
    {"expect": {"failing": 0, "value": [["$m1", "angle", 540], ["$m2", "angle", -270]]}}
  ],
  "always": {"failing": 0, "freedom": 1},
  "changes": [{"set": {"SL": 100}}, {"set": {"t": 6}}]
}
