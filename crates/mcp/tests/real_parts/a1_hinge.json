{
  "name": "Hinge assembly",
  "kind": "assembly",
  "parameters": {"t": 2, "R": 4, "kl": 16, "w": 30, "gap": 4.5, "pin": 1.5},
  "steps": [
    {"id": 1, "name": "Leaf A outline", "type": "sketch", "regions": [{"outer": {"type": "polygon", "points": [["w", 0], ["w", "5 * kl"], [0, "5 * kl"], [0, "4 * kl"], ["gap", "4 * kl"], ["gap", "3 * kl"], [0, "3 * kl"], [0, "2 * kl"], ["gap", "2 * kl"], ["gap", "kl"], [0, "kl"], [0, 0]]}}]},
    {"id": 2, "name": "Leaf A", "type": "extrude", "sketch": 1, "length": "t", "mode": "new_body"},
    {"id": 3, "name": "Leaf A's knuckle", "type": "sketch", "plane": {"origin": [0, "kl", 0], "z": [0, -1, 0], "x": [1, 0, 0]}, "regions": [{"outer": {"type": "circle", "cx": 0, "cy": "R", "r": "R"}}]},
    {"id": 4, "name": "Knuckle solid", "type": "extrude", "sketch": 3, "length": "kl"},
    {"id": 5, "name": "All three", "type": "pattern", "of": [4], "direction": [0, 1, 0], "count": 3, "spacing": "2 * kl"},
    {"id": 6, "name": "Leaf A's pin hole", "type": "sketch", "plane": {"origin": [0, "5 * kl + 1", 0], "z": [0, -1, 0], "x": [1, 0, 0]}, "regions": [{"outer": {"type": "circle", "cx": 0, "cy": "R", "r": "pin"}}]},
    {"id": 7, "name": "Drill it", "type": "extrude", "sketch": 6, "length": "5 * kl + 2", "mode": "remove"},
    {"id": 8, "name": "Leaf B outline, off to one side", "type": "sketch", "regions": [{"outer": {"type": "polygon", "points": [["100 - w", 0], ["100 - gap", 0], ["100 - gap", "kl"], [100, "kl"], [100, "2 * kl"], ["100 - gap", "2 * kl"], ["100 - gap", "3 * kl"], [100, "3 * kl"], [100, "4 * kl"], ["100 - gap", "4 * kl"], ["100 - gap", "5 * kl"], ["100 - w", "5 * kl"]]}}]},
    {"id": 9, "name": "Leaf B", "type": "extrude", "sketch": 8, "length": "t", "mode": "new_body"},
    {"id": 10, "name": "Leaf B's knuckle", "type": "sketch", "plane": {"origin": [0, "2 * kl", 0], "z": [0, -1, 0], "x": [1, 0, 0]}, "regions": [{"outer": {"type": "circle", "cx": 100, "cy": "R", "r": "R"}}]},
    {"id": 11, "name": "Knuckle solid", "type": "extrude", "sketch": 10, "length": "kl"},
    {"id": 12, "name": "Both", "type": "pattern", "of": [11], "direction": [0, 1, 0], "count": 2, "spacing": "2 * kl"},
    {"id": 13, "name": "Leaf B's pin hole", "type": "sketch", "plane": {"origin": [0, "5 * kl + 1", 0], "z": [0, -1, 0], "x": [1, 0, 0]}, "regions": [{"outer": {"type": "circle", "cx": 100, "cy": "R", "r": "pin"}}]},
    {"id": 14, "name": "Drill it", "type": "extrude", "sketch": 13, "length": "5 * kl + 2", "mode": "remove"},
    {"id": 15, "name": "Pin", "type": "sketch", "plane": {"origin": [-60, 0, 0], "z": [0, 0, 1], "x": [1, 0, 0]}, "regions": [{"outer": {"type": "circle", "r": "pin"}}]},
    {"id": 16, "name": "Pin solid", "type": "extrude", "sketch": 15, "length": "5 * kl", "mode": "new_body"},
    {"expect": {"parts": 3}},
    {"tool": "tab_new", "args": {"type": "assembly", "name": "Hinge"}},
    {"tool": "instance_add", "args": {"part": "f2", "fixed": true, "name": "Leaf A"}, "as": "a"},
    {"tool": "instance_add", "args": {"part": "f9", "name": "Leaf B"}, "as": "b"},
    {"tool": "instance_add", "args": {"part": "f16", "name": "Pin"}, "as": "p"},
    {"tool": "mate_add", "label": "Leaf B turns on Leaf A", "args": {"type": "revolute",
      "a": {"instance": "$b", "on": {"face": "f11:side.0", "point": "axis_end"}},
      "b": {"instance": "$a", "on": {"face": "f4:side.0", "point": "axis_start"}}}, "as": "turn"},
    {"expect": {"failing": 0, "origin": {"Leaf B": [-100, 0, 0]}}},
    {"tool": "mate_add", "label": "The pin stays in Leaf A", "args": {"type": "fastened",
      "a": {"instance": "$p", "on": {"face": "f16:side.0", "point": "axis_start"}},
      "b": {"instance": "$a", "on": {"frame": {"origin": [0, 0, 4], "z": [0, 1, 0], "x": [1, 0, 0]}}}}},
    {"expect": {"failing": 0, "freedom": 1}},
    {"expect": {"interferences": 0, "bom": {"Leaf A": 1, "Leaf B": 1, "Pin": 1}}},
    {"tool": "mate_set_value", "label": "Open it by 90 degrees", "args": {"id": "$turn", "dof": "angle", "value": 90}},
    {"expect": {"failing": 0, "origin": {"Leaf B": ["-R", 0, 104]}, "value": [["$turn", "angle", 90]]}},
    {"expect": {"interferences": 0}}
  ],
  "always": {"failing": 0}
}
