{
  "name": "Bench vise assembly",
  "kind": "assembly",
  "parameters": {"W": 60, "L": 140, "B": 12, "J": 30, "T": 16, "sr": 5, "lead": 2},
  "steps": [
    {"id": 1, "name": "Base", "type": "sketch", "regions": [{"outer": {"type": "rect", "x": 0, "y": "-W / 2", "w": "L", "h": "W"}}]},
    {"id": 2, "name": "Base solid", "type": "extrude", "sketch": 1, "length": "B", "mode": "new_body"},
    {"id": 3, "name": "Fixed jaw", "type": "sketch", "plane": {"origin": [0, 0, "B"], "on_face": "f2:end"}, "regions": [{"outer": {"type": "rect", "x": 0, "y": "-W / 2", "w": "T", "h": "W"}}]},
    {"id": 4, "name": "Fixed jaw solid", "type": "extrude", "sketch": 3, "length": "J"},
    {"id": 5, "name": "Screw support", "type": "sketch", "plane": {"origin": [0, 0, "B"]}, "regions": [{"outer": {"type": "rect", "x": "L - T", "y": "-W / 2", "w": "T", "h": "W"}}]},
    {"id": 6, "name": "Screw support solid", "type": "extrude", "sketch": 5, "length": "J"},
    {"id": 7, "name": "Screw hole", "type": "sketch", "plane": {"origin": ["L - T - 1", 0, 0], "z": [1, 0, 0], "x": [0, 1, 0]}, "regions": [{"outer": {"type": "circle", "cx": 0, "cy": "B + J / 2", "r": "sr"}}]},
    {"id": 8, "name": "Drill it", "type": "extrude", "sketch": 7, "length": "T + 2", "mode": "remove"},
    {"expect": {"parts": 1, "genus": [1], "volume": "L * W * B + 2 * T * W * J - pi * sr^2 * T"}},
    {"id": 9, "name": "Moving jaw", "type": "sketch", "plane": {"origin": [0, 300, 0]}, "regions": [{"outer": {"type": "rect", "x": 0, "y": "-W / 2", "w": "T", "h": "W"}}]},
    {"id": 10, "name": "Moving jaw solid", "type": "extrude", "sketch": 9, "length": "J", "mode": "new_body"},
    {"id": 11, "name": "Its nut", "type": "sketch", "plane": {"origin": [-1, 300, 0], "z": [1, 0, 0], "x": [0, 1, 0]}, "regions": [{"outer": {"type": "circle", "cx": 0, "cy": "J / 2", "r": "sr"}}]},
    {"id": 12, "name": "Tap it", "type": "extrude", "sketch": 11, "length": "T + 2", "mode": "remove", "bodies": ["f10"]},
    {"id": 13, "name": "Screw", "type": "sketch", "plane": {"origin": [0, 500, 0], "z": [1, 0, 0], "x": [0, 1, 0]}, "regions": [{"outer": {"type": "circle", "r": "sr"}}]},
    {"id": 14, "name": "Screw solid", "type": "extrude", "sketch": 13, "length": "L", "mode": "new_body"},
    {"expect": {"parts": 3}},
    {"tool": "tab_new", "args": {"type": "assembly", "name": "Vise"}},
    {"tool": "instance_add", "args": {"part": "f2", "fixed": true, "name": "Base"}, "as": "base"},
    {"tool": "instance_add", "args": {"part": "f10", "name": "Moving jaw", "at": {"origin": [60, -300, 12]}}, "as": "jaw"},
    {"tool": "instance_add", "args": {"part": "f14", "name": "Screw", "at": {"origin": [0, -500, 27]}}, "as": "screw"},
    {"tool": "mate_add", "label": "Jaw slides on the base", "args": {"type": "slider",
      "a": {"instance": "$jaw", "on": {"frame": {"origin": [0, 300, 0], "z": [1, 0, 0], "x": [0, 1, 0]}}},
      "b": {"instance": "$base", "on": {"frame": {"origin": [16, 0, 12], "z": [1, 0, 0], "x": [0, 1, 0]}}},
      "limits": [{"dof": "z", "min": -90, "max": 0}]}, "as": "slide"},
    {"tool": "mate_add", "label": "Screw turns in its support", "args": {"type": "revolute",
      "a": {"instance": "$screw", "on": {"frame": {"origin": [0, 500, 0], "z": [1, 0, 0], "x": [0, 1, 0]}}},
      "b": {"instance": "$base", "on": {"frame": {"origin": [16, 0, 27], "z": [1, 0, 0], "x": [0, 1, 0]}}}}, "as": "turn"},
    {"expect": {"failing": 0, "freedom": 2}},
    {"tool": "mate_set_value", "label": "Open the jaw 40", "args": {"id": "$slide", "dof": "z", "value": -40}},
    {"tool": "relation_add", "label": "The screw drives the jaw", "args": {"type": "rack_and_pinion", "distance": 2, "a": "$turn", "b": "$slide"}},
    {"expect": {"failing": 0, "freedom": 1, "origin": {"Moving jaw": ["T + 40", -300, "B"]}}},
    {"expect": {"interferences": 0}},
    {"tool": "mate_set_value", "label": "Five turns", "args": {"id": "$turn", "dof": "angle", "value": 1800}},
    {"expect": {"failing": 0, "origin": {"Moving jaw": ["T + 40 - 10", -300, "B"]}}}
  ],
  "always": {"failing": 0, "freedom": 1}
}
