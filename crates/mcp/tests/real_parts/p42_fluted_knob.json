    {"id": 2, "name": "Turned", "type": "revolve", "sketch": 1},
    {"id": 3, "name": "Flutes", "type": "sketch", "plane": {"origin": [0, 0, -1]}, "regions": [{"outer": {"type": "circle", "r": "fl"}, "repeat": {"type": "circular", "count": "n", "radius": "R + 1"}}]},
    {"id": 4, "name": "Cut them", "type": "extrude", "sketch": 3, "length": "H + 2", "mode": "remove"},
    {"id": 5, "name": "Blind hole", "type": "sketch", "plane": {"origin": [0, 0, -1]}, "regions": [{"outer": {"type": "circle", "r": "hole"}}]},
