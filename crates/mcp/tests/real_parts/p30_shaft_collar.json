{
  "name": "Split shaft collar",
  "kind": "clamp",
  "parameters": {"OD": 36, "ID": 20, "W": 12, "slit": 1.5, "screw": 4.4, "head": 7.6},
  "steps": [
    {"id": 1, "name": "Ring", "type": "sketch", "regions": [{"outer": {"type": "circle", "r": "OD / 2"}, "holes": [{"type": "circle", "r": "ID / 2"}]}]},
    {"id": 2, "name": "Collar", "type": "extrude", "sketch": 1, "length": "W"},
    {"expect": {"volume": "pi * ((OD / 2)^2 - (ID / 2)^2) * W", "genus": [1]}},
    {"id": 3, "name": "Slit", "type": "sketch", "plane": {"origin": [0, 0, -1]}, "regions": [{"outer": {"type": "rect", "x": "ID / 2 - 1", "y": "-slit / 2", "w": "(OD - ID) / 2 + 2", "h": "slit"}}]},
    {"id": 4, "name": "Cut slit", "type": "extrude", "sketch": 3, "length": "W + 2", "mode": "remove"},
    {"expect": {"genus": [0]}},
    {"id": 5, "name": "Clamp screw", "type": "sketch", "plane": {"origin": [0, -20, 0], "z": [0, 1, 0], "x": [1, 0, 0]}, "regions": [{"outer": {"type": "circle", "cx": "(OD + ID) / 4", "cy": "-W / 2", "r": "screw / 2"}}]},
    {"id": 6, "name": "Drill it", "type": "extrude", "sketch": 5, "length": 40, "mode": "remove"},
    {"id": 7, "name": "Screw head seat", "type": "sketch", "plane": {"origin": [0, -20, 0], "z": [0, 1, 0], "x": [1, 0, 0]}, "regions": [{"outer": {"type": "circle", "cx": "(OD + ID) / 4", "cy": "-W / 2", "r": "head / 2"}}]},
    {"id": 8, "name": "Counterbore", "type": "extrude", "sketch": 7, "length": 13, "mode": "remove"},
    {"id": 9, "name": "Bore's edges", "type": "chamfer", "edges": {"radius": "ID / 2"}, "distance": 0.5}
  ],
  "always": {"genus": [2], "bounds": [["-OD / 2", "-OD / 2", 0], ["OD / 2", "OD / 2", "W"]]},
  "changes": [{"set": {"W": 14}}, {"set": {"OD": 40}}]
}
