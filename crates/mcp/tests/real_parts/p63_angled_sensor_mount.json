    {"id": 4, "name": "By the rib", "type": "hole", "plane": {"point": [0, 0, 100], "normal": [0, 0, 1]}, "points": [[66, 0]], "size": "M6", "style": "counterbore", "end": "through_all"},
    {"id": 5, "name": "Countersunk", "type": "hole", "plane": {"point": [0, 0, 100], "normal": [0, 0, 1]}, "points": [[45, -10]], "size": "M5", "style": "countersink", "end": "through_all"},
    {"id": 6, "name": "Tapped in the rib", "type": "hole", "plane": {"point": [0, 0, 100], "normal": [0, 0, 1]}, "points": [[80, 0]], "size": "M8", "tapped": true, "depth": 12}
