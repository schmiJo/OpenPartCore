     "regions": [{"outer": {"type": "polygon", "points": [[0, 0], ["W", 0], ["W", "H"], ["xw + (H - base) * tan(dr)", "H"], ["xw", "base"], ["R", "base"], [0, "base + R * tan(a)"]]}}]},
    {"id": 2, "name": "Body", "type": "extrude", "sketch": 1, "length": "d"},
