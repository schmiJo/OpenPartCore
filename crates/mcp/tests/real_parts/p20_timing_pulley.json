    {"id": 3, "name": "Tooth space", "type": "sketch", "plane": {"origin": [0, 0, -1]}, "regions": [{"outer": {"type": "rounded_rect", "cx": "OD / 2", "cy": 0, "w": "2 * gd", "h": "gw", "r": 0.5}}]},
    {"id": 4, "name": "Cut it", "type": "extrude", "sketch": 3, "length": "F + 2", "mode": "remove"},
    {"id": 5, "name": "All of them", "type": "pattern", "of": [4], "count": "n"},
    {"id": 6, "name": "Lower flange", "type": "sketch", "plane": {"origin": [0, 0, "-ft"]}, "regions": [{"outer": {"type": "circle", "r": "fl"}}]},
    {"id": 7, "name": "Lower flange solid", "type": "extrude", "sketch": 6, "length": "ft"},
    {"id": 8, "name": "Upper flange", "type": "sketch", "plane": {"origin": [0, 0, "F"]}, "regions": [{"outer": {"type": "circle", "r": "fl"}}]},
    {"id": 9, "name": "Upper flange solid", "type": "extrude", "sketch": 8, "length": "ft"},
    {"id": 10, "name": "Hub", "type": "sketch", "plane": {"origin": [0, 0, "F + ft"], "on_face": "f9:end"}, "regions": [{"outer": {"type": "circle", "r": "hub"}}]},
