{
  "name": "Timing pulley",
  "kind": "pulley",
  "parameters": {"n": 20, "OD": 38, "F": 12, "ft": 1.5, "fl": 23, "hub": 14, "hh": 8, "bore": 8, "gw": 2.6, "gd": 1.4},
  "steps": [
