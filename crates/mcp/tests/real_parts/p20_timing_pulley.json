    {"id": 14, "name": "Set screw", "type": "sketch", "plane": {"z": [1, 0, 0], "x": [0, 1, 0]}, "regions": [{"outer": {"type": "circle", "cx": 0, "cy": "F + ft + hh / 2", "r": 2}}]},
    {"id": 15, "name": "Drill it", "type": "extrude", "sketch": 14, "length": "hub + 1", "mode": "remove"}
  ],
  "always": {"genus": [2], "bounds": [["-fl", "-fl", "-ft"], ["fl", "fl", "F + ft + hh"]]},
  "changes": [{"set": {"F": 16}}, {"set": {"n": 24}}, {"set": {"hh": 10}}]
