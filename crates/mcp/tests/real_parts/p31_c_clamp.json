{
  "name": "C clamp frame",
  "kind": "clamp",
  "parameters": {"D": 80, "H": 100, "arm": 15, "back": 20, "W": 16, "ri": 10, "ro": 20, "boss": 12, "tap": 8.5, "c": 1.5},
  "steps": [
    {"id": 1, "name": "Side view", "type": "sketch", "plane": {"z": [0, -1, 0], "x": [1, 0, 0]},
     "regions": [{"outer": {"type": "polygon", "points": [[0, 0], ["D", 0], ["D", "arm"], ["back", "arm"], ["back", "H - arm"], ["D", "H - arm"], ["D", "H"], [0, "H"]]}}]},
    {"id": 2, "name": "Frame", "type": "extrude", "sketch": 1, "length": "W"},
    {"id": 3, "name": "Throat", "type": "fillet", "edges": {"any": [{"between": ["f2:side.2", "f2:side.3"]}, {"between": ["f2:side.3", "f2:side.4"]}]}, "radius": "ri"},
    {"id": 4, "name": "Back", "type": "fillet", "edges": {"any": [{"between": ["f2:side.0", "f2:side.7"]}, {"between": ["f2:side.6", "f2:side.7"]}]}, "radius": "ro"},
    {"expect": {"volume": "W * (D * H - (D - back) * (H - 2 * arm) + 2 * (1 - pi / 4) * ri^2 - 2 * (1 - pi / 4) * ro^2)", "genus": [0]}},
    {"id": 5, "name": "All round both sides", "type": "chamfer", "edges": {"any": [{"on_face": "f2:start"}, {"on_face": "f2:end"}]}, "distance": "c"},
    {"id": 6, "name": "Screw boss", "type": "sketch", "plane": {"origin": [0, 0, "H - arm - 10"]}, "regions": [{"outer": {"type": "circle", "cx": "D - 15", "cy": "-W / 2", "r": "boss"}}]},
    {"id": 7, "name": "Boss solid", "type": "extrude", "sketch": 6, "length": "arm + 20"},
    {"id": 8, "name": "Tap", "type": "sketch", "plane": {"origin": [0, 0, "H - arm - 11"]}, "regions": [{"outer": {"type": "circle", "cx": "D - 15", "cy": "-W / 2", "r": "tap / 2"}}]},
    {"id": 9, "name": "Drill it", "type": "extrude", "sketch": 8, "length": "arm + 22", "mode": "remove"}
  ],
  "always": {"genus": [1], "bounds": [[0, "-W / 2 - boss", 0], ["D", "W / 2 - W / 2 + boss - W / 2", "H + 10"]]},
  "changes": [{"set": {"W": 20}}, {"set": {"H": 120}}]
}
