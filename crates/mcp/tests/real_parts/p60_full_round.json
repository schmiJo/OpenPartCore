{
  "name": "Full round rib and a domed post",
  "kind": "moulded",
  "parameters": {"L": 80, "W": 40, "T": 4, "g": 4, "h": 15, "R": 5, "H": 18},
  "steps": [
    {"id": 1, "name": "Plate outline", "type": "sketch", "regions": [{"outer": {"type": "rect", "x": 0, "y": 0, "w": "L", "h": "W"}}]},
    {"id": 2, "name": "Plate", "type": "extrude", "sketch": 1, "length": "T"},
    {"id": 3, "name": "Rib outline", "type": "sketch", "plane": {"origin": [0, 0, "T"], "on_face": "f2:end"}, "regions": [{"outer": {"type": "rect", "x": 10, "y": "W / 2 - g / 2", "w": "L - 20", "h": "g"}}]},
    {"id": 4, "name": "Rib", "type": "extrude", "sketch": 3, "length": "h"},
    {"id": 5, "name": "Round the rib's top fully", "type": "fillet", "edges": {"any": [{"between": ["f4:end", "f4:side.0"]}, {"between": ["f4:end", "f4:side.2"]}]}, "radius": "g / 2"},
    {"id": 6, "name": "Post outline", "type": "sketch", "plane": {"origin": [0, 0, "T"], "on_face": "f2:end"}, "regions": [{"outer": {"type": "circle", "cx": 10, "cy": 8, "r": "R"}}]},
    {"id": 7, "name": "Post", "type": "extrude", "sketch": 6, "length": "H"},
    {"id": 8, "name": "Dome its top", "type": "fillet", "edges": {"between": ["f7:end", "f7:side.0"]}, "radius": "R"}
  ],
  "always": {
    "volume": "L * W * T + (L - 20) * (g * h - (4 - pi) / 8 * g^2) + pi * R^2 * (H - R) + 2 / 3 * pi * R^3",
    "genus": [0],
    "bounds": [[0, 0, 0], ["L", "W", "T + H"]]
  },
  "changes": [{"set": {"g": 3}}, {"set": {"H": 22}}]
}
