{
  "name": "Crank press assembly",
  "scan_fixed": ["t"],
  "kind": "assembly",
  "parameters": {"a": 30, "b": 100, "t": 5, "e": 16, "pin": 3},
  "steps": [
    {"id": 1, "name": "Bed outline", "type": "sketch", "plane": {"origin": [0, 0, -10]}, "regions": [{"outer": {"type": "rect", "x": -50, "y": -25, "w": 250, "h": 50}}]},
    {"id": 2, "name": "Bed", "type": "extrude", "sketch": 1, "length": 10, "mode": "new_body"},
    {"id": 3, "name": "Crank outline", "type": "sketch", "plane": {"origin": [0, 100, 0]}, "regions": [{"outer": {"type": "rounded_rect", "cx": "a / 2", "cy": 0, "w": "a + e", "h": "e", "r": "e / 2"}, "holes": [{"type": "circle", "cx": 0, "cy": 0, "r": "pin"}, {"type": "circle", "cx": "a", "cy": 0, "r": "pin"}]}]},
    {"id": 4, "name": "Crank", "type": "extrude", "sketch": 3, "length": "t", "mode": "new_body"},
    {"id": 5, "name": "Rod outline", "type": "sketch", "plane": {"origin": [0, 200, 0]}, "regions": [{"outer": {"type": "rounded_rect", "cx": "b / 2", "cy": 0, "w": "b + e", "h": "e", "r": "e / 2"}, "holes": [{"type": "circle", "cx": 0, "cy": 0, "r": "pin"}, {"type": "circle", "cx": "b", "cy": 0, "r": "pin"}]}]},
    {"id": 6, "name": "Rod", "type": "extrude", "sketch": 5, "length": "t", "mode": "new_body"},
    {"id": 7, "name": "Slider outline", "type": "sketch", "plane": {"origin": [0, 300, 0]}, "regions": [{"outer": {"type": "rect", "x": -12, "y": -12, "w": 24, "h": 24}}]},
    {"id": 8, "name": "Slider", "type": "extrude", "sketch": 7, "length": "3 * t", "mode": "new_body"},
    {"id": 9, "name": "Slot for the rod", "type": "sketch", "plane": {"origin": [0, 300, "t"]}, "regions": [{"outer": {"type": "rect", "x": -13, "y": -13, "w": 22, "h": 26}}]},
    {"id": 10, "name": "Cut it", "type": "extrude", "sketch": 9, "length": "t", "mode": "remove", "bodies": ["f8"]},
    {"expect": {"parts": 4}},
    {"tool": "tab_new", "args": {"type": "assembly", "name": "Press"}},
    {"tool": "instance_add", "args": {"part": "f2", "fixed": true, "name": "Bed"}, "as": "bed"},
    {"tool": "instance_add", "args": {"part": "f4", "name": "Crank", "at": {"origin": [0, -100, 0]}}, "as": "crank"},
    {"tool": "instance_add", "args": {"part": "f6", "name": "Rod", "at": {"origin": [30, -200, 5]}}, "as": "rod"},
    {"tool": "instance_add", "args": {"part": "f8", "name": "Slider", "at": {"origin": [130, -300, 0]}}, "as": "slider"},
    {"tool": "mate_add", "label": "Crank on the bed", "args": {"type": "revolute",
      "a": {"instance": "$crank", "on": {"face": "f4:hole.0.side.0", "point": "axis_start"}},
      "b": {"instance": "$bed", "on": {"frame": {"origin": [0, 0, 0], "z": [0, 0, 1], "x": [1, 0, 0]}}}}, "as": "m1"},
    {"tool": "mate_add", "label": "Rod on the crank", "args": {"type": "revolute",
      "a": {"instance": "$rod", "on": {"face": "f6:hole.0.side.0", "point": "axis_start"}},
      "b": {"instance": "$crank", "on": {"face": "f4:hole.1.side.0", "point": "axis_end"}}}},
    {"tool": "mate_add", "label": "Slider in its way", "args": {"type": "slider",
      "a": {"instance": "$slider", "on": {"frame": {"origin": [0, 300, 0], "z": [1, 0, 0], "x": [0, 1, 0]}}},
      "b": {"instance": "$bed", "on": {"frame": {"origin": [0, 0, 0], "z": [1, 0, 0], "x": [0, 1, 0]}}}}},
    {"tool": "mate_add", "label": "Rod on the slider", "args": {"type": "revolute",
      "a": {"instance": "$rod", "on": {"face": "f6:hole.1.side.0", "point": "axis_start"}},
      "b": {"instance": "$slider", "on": {"frame": {"origin": [0, 300, 5], "z": [0, 0, 1], "x": [1, 0, 0]}}}}},
    {"expect": {"failing": 0, "freedom": 1, "origin": {"Slider": ["a + b", -300, 0]}}},
    {"expect": {"interferences": 0}},
    {"tool": "mate_set_value", "label": "A quarter turn", "args": {"id": "$m1", "dof": "angle", "value": 90}},
    {"expect": {"failing": 0, "origin": {"Slider": ["sqrt(b^2 - a^2)", -300, 0]}}},
    {"expect": {"interferences": 0}},
    {"tool": "mate_set_value", "label": "Half way round", "args": {"id": "$m1", "dof": "angle", "value": 180}},
    {"expect": {"failing": 0, "origin": {"Slider": ["b - a", -300, 0]}}},
    {"tool": "mate_set_value", "label": "A turn and a bit", "args": {"id": "$m1", "dof": "angle", "value": 400}},
    {"expect": {"failing": 0, "origin": {"Slider": ["a * cos(40) + sqrt(b^2 - (a * sin(40))^2)", -300, 0]}, "value": [["$m1", "angle", 400]]}}
  ],
  "always": {"failing": 0, "freedom": 1},
  "changes": [{"set": {"b": 120}, "then": [{"tool": "mate_set_value", "args": {"id": "$m1", "dof": "angle", "value": 400}}], "expect": {"origin": {"Slider": ["a * cos(40) + sqrt(b^2 - (a * sin(40))^2)", -300, 0]}}}, {"set": {"a": 40}, "then": [{"tool": "mate_set_value", "args": {"id": "$m1", "dof": "angle", "value": 400}}], "expect": {"origin": {"Slider": ["a * cos(40) + sqrt(b^2 - (a * sin(40))^2)", -300, 0]}}}]
}
